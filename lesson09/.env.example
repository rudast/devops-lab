# Шаблон конфигурации. Скопируйте: cp .env.example .env и впишите СВОИ значения.
# Этот файл (.env.example) коммитим. Файл .env — НИКОГДА.
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=appdb
APP_VERSION=lesson-09
# Порт Nginx на вашей машине. Если 80 занят (или нет прав) — поставьте 8080
HTTP_PORT=80
