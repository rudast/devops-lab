# Часть 3. Скопируйте в backend.tf:  cp backend.tf.example backend.tf
#
# State хранится в PostgreSQL курса (бэкенд "pg"). На время plan/apply Terraform ставит
# блокировку: второй человек в тот же state получит «Error acquiring the state lock».
#
# В блоке backend НЕЛЬЗЯ использовать переменные, а пароли в файлах держать нельзя.
# Поэтому адрес и пароль базы — в переменной окружения (строку даёт преподаватель):
#   export PG_CONN_STR="postgres://…?sslmode=require"
# а свой state каждый выбирает через workspace:
#   terraform init
#   terraform workspace new <prefix>-l11

terraform {
  backend "pg" {
    schema_name = "devops_course" # общая схема курса; внутри — по workspace на каждого
  }
}
